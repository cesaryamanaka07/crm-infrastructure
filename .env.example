# ==========================================
# Docker networks
# ==========================================

PLATFORM_NETWORK=plataforma_network
MANAGEMENT_NETWORK=management

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_CONTAINER_NAME=postgres
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=crm_database
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# ==========================================
# Redis
# ==========================================

REDIS_CONTAINER_NAME=redis
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=change_this_password
REDIS_PORT=6379

# ==========================================
# MinIO
# ==========================================

MINIO_CONTAINER_NAME=minio
MINIO_IMAGE=quay.io/minio/minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==========================================
# Portainer
# ==========================================

PORTAINER_CONTAINER_NAME=portainer
PORTAINER_IMAGE=portainer/portainer-ce:latest
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443

# ==========================================
# Cloudflare Tunnel
# ==========================================

CLOUDFLARED_CONTAINER_NAME=cloudflared
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN=replace_with_your_tunnel_token
