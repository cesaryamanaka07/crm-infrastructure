DATABASE_URL=
# Mesma SECRET_KEY usada pelo auth-service para validar o JWT interno.
SECRET_KEY=
ALGORITHM=HS256
CORS_ORIGINS=
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SOCIAL_HOST_PORT=

# URLs públicas ficam somente no .env real.
FRONTEND_RETURN_URL=
SOCIAL_PUBLIC_BASE_URL=
FACEBOOK_CALLBACK_URL=
INSTAGRAM_CALLBACK_URL=
LINKEDIN_CALLBACK_URL=

# Endpoints oficiais dos provedores ficam no .env real.
FACEBOOK_AUTHORIZATION_BASE_URL=
FACEBOOK_GRAPH_BASE_URL=
INSTAGRAM_AUTHORIZATION_URL=
INSTAGRAM_TOKEN_URL=
INSTAGRAM_GRAPH_BASE_URL=
LINKEDIN_AUTHORIZATION_URL=
LINKEDIN_TOKEN_URL=
LINKEDIN_USERINFO_URL=

META_CLIENT_ID=
META_CLIENT_SECRET=
META_API_VERSION=
FACEBOOK_API_VERSION=v23.0
INSTAGRAM_API_VERSION=
# IDs opcionais criados em Facebook Login for Business > Configurações.
FACEBOOK_LOGIN_CONFIG_ID=
INSTAGRAM_LOGIN_CONFIG_ID=
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,read_insights

# Use o Instagram App ID e o Instagram App Secret exibidos em
# Meta for Developers > Instagram > Configuração da API.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# facebook: usa Facebook Login e exige Instagram profissional vinculado a uma Página.
# instagram: usa Instagram Login com Instagram App ID próprio.
INSTAGRAM_AUTH_MODE=facebook
INSTAGRAM_SCOPES=pages_show_list,pages_read_engagement,instagram_basic,instagram_content_publish,instagram_manage_insights

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid,profile,email,w_member_social
