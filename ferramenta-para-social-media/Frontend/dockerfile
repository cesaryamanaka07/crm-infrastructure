FROM node:20-alpine AS build

WORKDIR /code

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_AUTH_SERVICE_URL
ARG VITE_CONTENT_SERVICE_URL
ARG VITE_SOCIAL_SERVICE_URL
ARG VITE_AUTOMATION_SERVICE_URL
ARG VITE_BLOG_SERVICE_URL
ARG VITE_N8N_PUBLIC_URL
ARG VITE_TYPEBOT_BUILDER_URL
ARG VITE_TYPEBOT_VIEWER_URL
ENV VITE_AUTH_SERVICE_URL=${VITE_AUTH_SERVICE_URL}
ENV VITE_CONTENT_SERVICE_URL=${VITE_CONTENT_SERVICE_URL}
ENV VITE_SOCIAL_SERVICE_URL=${VITE_SOCIAL_SERVICE_URL}
ENV VITE_AUTOMATION_SERVICE_URL=${VITE_AUTOMATION_SERVICE_URL}
ENV VITE_BLOG_SERVICE_URL=${VITE_BLOG_SERVICE_URL}
ENV VITE_N8N_PUBLIC_URL=${VITE_N8N_PUBLIC_URL}
ENV VITE_TYPEBOT_BUILDER_URL=${VITE_TYPEBOT_BUILDER_URL}
ENV VITE_TYPEBOT_VIEWER_URL=${VITE_TYPEBOT_VIEWER_URL}

RUN npm run build

FROM nginx:alpine

COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /code/dist /usr/share/nginx/html
