DATABASE_URL=
# Use exatamente a mesma SECRET_KEY configurada no auth-service.
SECRET_KEY=
ALGORITHM=HS256
CORS_ORIGINS=
SERVICE_HOST=
SERVICE_PORT=

# Endpoint compatível com OpenAI, por exemplo: https://seu-dominio/v1
OMNIROUTE_BASE_URL=
# Gere uma chave nova no OmniRoute. Nunca envie esse valor ao GitHub.
OMNIROUTE_API_KEY=
OMNIROUTE_TEXT_MODEL=auto/best-chat
# Exige um provedor de imagens compatível conectado ao OmniRoute.
OMNIROUTE_IMAGE_MODEL=
OMNIROUTE_TIMEOUT_SECONDS=120
